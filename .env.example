# Copy to your environment / secrets manager. NEVER commit real values.

# --- Required in production ---
DJANGO_SECRET_KEY=            # random 64+ chars; without it the app refuses to boot when DEBUG=0
DJANGO_DEBUG=0                # must be 0 in production
DJANGO_ALLOWED_HOSTS=your.domain.com,app.internal

# --- Database: omit POSTGRES_* entirely to stay on SQLite (dev/small installs) ---
POSTGRES_DB=godezk
POSTGRES_USER=godezk_app          # least-privilege app user, NOT the postgres superuser
POSTGRES_PASSWORD=<long-random>   # from your secrets manager, not hardcoded
POSTGRES_HOST=db.internal         # or RDS/Cloud SQL endpoint
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require          # encrypt in transit; 'prefer' only for local dev
DJANGO_CONN_MAX_AGE=300           # persistent DB connections under load

# --- Object storage: omit AWS_* to keep local private_uploads/ (dev/small installs) ---
AWS_STORAGE_BUCKET_NAME=godezk-uploads
AWS_S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com   # omit for AWS; set for MinIO/etc
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
